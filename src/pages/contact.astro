---
import BaseLayout from "../layouts/BaseLayout.astro";
import faq from "../data/faq.json";
import contact from "../data/contact.json";
import siteApi from "../data/siteApi.json";

const firstCategory = contact.categories[0];
const formAction = siteApi.endpoint || contact.action;
---

<BaseLayout title="Contact | あさゆみ" description="あさゆみへの歌唱依頼、レッスン、取材、その他お問い合わせ。">
  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Contact</p>
      <h1 class="section-title">お問い合わせ</h1>
      <div class="contact-tabs" data-contact-categories={JSON.stringify(contact.categories)} role="tablist" aria-label="問い合わせ種別">
        {contact.categories.map((type, index) => (
          <button class="contact-tab" type="button" data-category={type.id} aria-pressed={index === 0 ? "true" : "false"} aria-selected={index === 0 ? "true" : "false"} role="tab">
            <strong>{type.label}</strong>
            <span>{type.description}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section band contact-form-section" id="contact-form">
    <div class="section-inner narrow">
      <p class="section-kicker">Form</p>
      <h2 class="section-title section-title-medium" data-form-title>{firstCategory.label}</h2>
      <p class="section-lead" data-form-intro>{firstCategory.intro}</p>

      <iframe class="hidden-submit-frame" name="contact-submit-frame" title="contact-submit-frame"></iframe>

      <form class="contact-form" action={formAction} method="post" target="contact-submit-frame" data-contact-form data-category-form="performance" data-action={formAction}>
        <fieldset class="contact-form-fieldset" data-form-fieldset>
          <input type="hidden" name="category" value="歌唱依頼" />
          <input type="hidden" name="inquiryType" value="performance" />
          <input type="hidden" name="personInCharge" value="" />
          <input type="hidden" name="userAgent" value="" data-user-agent />
          <label class="honeypot">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <div class="form-grid">
            <label>
              <span>お名前</span>
              <input type="text" name="name" autocomplete="name" placeholder="例：山田 花子" required />
            </label>
            <label>
              <span>ご所属</span>
              <input type="text" name="organization" autocomplete="organization" placeholder="例：○○市民ホール / ○○株式会社" />
            </label>
            <label>
              <span>メールアドレス</span>
              <input type="email" name="email" autocomplete="email" placeholder="例：example@example.com" required />
            </label>
            <label>
              <span>希望日時</span>
              <input type="text" name="preferredDate" placeholder="例：2026年9月 土日午後 / 未定" />
            </label>
            <label>
              <span>会場</span>
              <input type="text" name="venue" placeholder="例：大阪市内のホール / ○○小学校体育館 / 未定" />
            </label>
            <label>
              <span>ピアノの有無</span>
              <select name="hasPiano">
                <option value="">選択してください</option>
                <option value="あり">あり</option>
                <option value="なし">なし</option>
                <option value="未定">未定</option>
              </select>
            </label>
            <label>
              <span>ピアノがない場合、音源を流す設備の有無</span>
              <select name="hasAudioEquipment">
                <option value="">選択してください</option>
                <option value="あり">あり</option>
                <option value="なし">なし</option>
                <option value="未定">未定</option>
              </select>
            </label>
            <label>
              <span>ご予算</span>
              <input type="text" name="budget" placeholder="例：5万円〜10万円程度 / 未定" />
            </label>
            <label class="full">
              <span>内容詳細</span>
              <textarea name="message" rows="7" placeholder="例：式典での歌唱を20分ほどお願いしたいです。対象は約100名です。" required></textarea>
            </label>
            <div class="full checkbox-field">
              <p>ピアノ生演奏の場合、あさゆみと伴奏者を含め、必ず3人以上での演奏となりますことご了承ください。</p>
              <label class="checkbox-inline">
                <input type="checkbox" name="acknowledgeAccompanist" value="確認しました" required />
                <span>確認しました</span>
              </label>
            </div>
          </div>

          <p class="form-status" data-form-status aria-live="polite"></p>
          <div class="button-row">
            <button class="button primary" type="submit">送信する</button>
          </div>
        </fieldset>
      </form>

      <form class="contact-form" action={formAction} method="post" target="contact-submit-frame" data-contact-form data-category-form="lesson" data-action={formAction} hidden>
        <fieldset class="contact-form-fieldset" data-form-fieldset disabled>
          <input type="hidden" name="category" value="レッスン／ワークショップ" />
          <input type="hidden" name="inquiryType" value="lesson" />
          <input type="hidden" name="personInCharge" value="" />
          <input type="hidden" name="userAgent" value="" data-user-agent />
          <label class="honeypot">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <p class="form-note">個人レッスンの場合、基本的に男性は旭・女性はゆみが担当しますが、ご希望があればお伝えください。</p>
          <div class="form-grid">
            <label>
              <span>お名前</span>
              <input type="text" name="name" autocomplete="name" placeholder="例：山田 花子" required />
            </label>
            <label>
              <span>ご所属</span>
              <input type="text" name="organization" autocomplete="organization" placeholder="例：○○合唱団 / 個人" />
            </label>
            <label>
              <span>メールアドレス</span>
              <input type="email" name="email" autocomplete="email" placeholder="例：example@example.com" required />
            </label>
            <label>
              <span>希望日時</span>
              <input type="text" name="preferredDate" placeholder="例：平日夕方 / 土日午前" />
            </label>
            <label>
              <span>人数</span>
              <input type="text" name="lessonPeople" placeholder="例：1名 / 合唱団20名" />
            </label>
            <label>
              <span>レッスン内容</span>
              <input type="text" name="lessonContent" placeholder="例：発声、歌曲指導、合唱指導" />
            </label>
            <label>
              <span>目的</span>
              <input type="text" name="lessonPurpose" placeholder="例：趣味 / 発表会 / 受験" />
            </label>
            <label class="full">
              <span>内容詳細</span>
              <textarea name="message" rows="7" placeholder="例：発表会に向けて発声と歌唱を見てほしいです。"></textarea>
            </label>
          </div>

          <p class="form-status" data-form-status aria-live="polite"></p>
          <div class="button-row">
            <button class="button primary" type="submit">送信する</button>
          </div>
        </fieldset>
      </form>

      <form class="contact-form" action={formAction} method="post" target="contact-submit-frame" data-contact-form data-category-form="media" data-action={formAction} hidden>
        <fieldset class="contact-form-fieldset" data-form-fieldset disabled>
          <input type="hidden" name="category" value="メディア／取材" />
          <input type="hidden" name="inquiryType" value="media" />
          <input type="hidden" name="personInCharge" value="" />
          <input type="hidden" name="userAgent" value="" data-user-agent />
          <label class="honeypot">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <div class="form-grid">
            <label>
              <span>お名前</span>
              <input type="text" name="name" autocomplete="name" placeholder="例：山田 花子" required />
            </label>
            <label>
              <span>ご所属</span>
              <input type="text" name="organization" autocomplete="organization" placeholder="例：○○編集部 / ○○制作会社" />
            </label>
            <label>
              <span>媒体名</span>
              <input type="text" name="mediaName" placeholder="例：○○新聞 / ○○番組 / Webメディア名" />
            </label>
            <label>
              <span>メールアドレス</span>
              <input type="email" name="email" autocomplete="email" placeholder="例：example@example.com" required />
            </label>
            <label>
              <span>掲載・放送予定日時</span>
              <input type="text" name="publishSchedule" placeholder="例：2026年7月頃 / 未定" />
            </label>
            <label class="full">
              <span>内容詳細</span>
              <textarea name="message" rows="7" placeholder="例：夫婦声楽デュオとしての活動について取材希望です。" required></textarea>
            </label>
          </div>

          <p class="form-status" data-form-status aria-live="polite"></p>
          <div class="button-row">
            <button class="button primary" type="submit">送信する</button>
          </div>
        </fieldset>
      </form>

      <form class="contact-form" action={formAction} method="post" target="contact-submit-frame" data-contact-form data-category-form="other" data-action={formAction} hidden>
        <fieldset class="contact-form-fieldset" data-form-fieldset disabled>
          <input type="hidden" name="category" value="その他" />
          <input type="hidden" name="inquiryType" value="other" />
          <input type="hidden" name="personInCharge" value="" />
          <input type="hidden" name="userAgent" value="" data-user-agent />
          <label class="honeypot">
            <span>Website</span>
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </label>

          <div class="form-grid">
            <label>
              <span>お名前</span>
              <input type="text" name="name" autocomplete="name" placeholder="例：山田 花子" required />
            </label>
            <label>
              <span>ご所属</span>
              <input type="text" name="organization" autocomplete="organization" placeholder="例：任意" />
            </label>
            <label>
              <span>メールアドレス</span>
              <input type="email" name="email" autocomplete="email" placeholder="例：example@example.com" required />
            </label>
            <label class="full">
              <span>内容詳細</span>
              <textarea name="message" rows="7" placeholder="例：ご相談内容をご記入ください。" required></textarea>
            </label>
          </div>

          <p class="form-status" data-form-status aria-live="polite"></p>
          <div class="button-row">
            <button class="button primary" type="submit">送信する</button>
          </div>
        </fieldset>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">FAQ</p>
      <h2 class="section-title section-title-medium">よくある質問</h2>
      <div class="grid" style="margin-top: 34px;">
        {faq.map((item) => (
          <article class="card">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    type ContactCategory = {
      id: string;
      label: string;
      description: string;
      intro: string;
    };

    const list = document.querySelector<HTMLElement>("[data-contact-categories]");
    const categories = JSON.parse(list?.dataset.contactCategories || "[]") as ContactCategory[];
    const cards = document.querySelectorAll<HTMLButtonElement>("[data-category]");
    const forms = document.querySelectorAll<HTMLFormElement>("[data-contact-form]");
    const title = document.querySelector<HTMLElement>("[data-form-title]");
    const intro = document.querySelector<HTMLElement>("[data-form-intro]");
    const iframe = document.querySelector<HTMLIFrameElement>(".hidden-submit-frame");
    let submittedForm: HTMLFormElement | null = null;

    const setFormDisabled = (form: HTMLFormElement, disabled: boolean) => {
      const fieldset = form.querySelector<HTMLFieldSetElement>("[data-form-fieldset]");
      if (fieldset) fieldset.disabled = disabled;
    };

    const setCategory = (id: string) => {
      const category = categories.find((item) => item.id === id) || categories[0];
      if (!category) return;

      cards.forEach((card) => {
        const active = card.dataset.category === category.id;
        card.setAttribute("aria-pressed", String(active));
        card.setAttribute("aria-selected", String(active));
      });

      forms.forEach((form) => {
        const active = form.dataset.categoryForm === category.id;
        form.hidden = !active;
        setFormDisabled(form, !active);
      });

      if (title) title.textContent = category.label;
      if (intro) intro.textContent = category.intro;
    };

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        setCategory(card.dataset.category || "performance");
        document.querySelector("#contact-form")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    document.querySelectorAll<HTMLInputElement>("[data-user-agent]").forEach((input) => {
      input.value = navigator.userAgent;
    });
    setCategory("performance");

    forms.forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (!form.dataset.action || form.dataset.action.includes("GOOGLE_APPS_SCRIPT")) {
          event.preventDefault();
          const status = form.querySelector<HTMLElement>("[data-form-status]");
          if (status) status.textContent = "現在フォーム準備中です。";
          return;
        }
        submittedForm = form;
        const status = form.querySelector<HTMLElement>("[data-form-status]");
        if (status) status.textContent = "送信中です。";
      });
    });

    iframe?.addEventListener("load", () => {
      if (!submittedForm) return;
      submittedForm.reset();
      submittedForm = null;
      setCategory("performance");
      document.querySelectorAll<HTMLInputElement>("[data-user-agent]").forEach((input) => {
        input.value = navigator.userAgent;
      });
      const status = document.querySelector<HTMLFormElement>('[data-contact-form][data-category-form="performance"]')?.querySelector<HTMLElement>("[data-form-status]");
      if (status) status.textContent = "送信しました。内容を確認のうえ、数日以内にご返信いたします。";
    });
  </script>
</BaseLayout>
