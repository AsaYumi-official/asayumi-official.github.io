---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import hero from "../data/homeHero.json";
import youtube from "../data/youtube.json";
import { getWorksData } from "../lib/contentSources";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (href: string) => `${basePath}${href.replace(/^\//, "")}`;
const asset = (href: string) => href.startsWith("http") ? href : `${basePath}${href.replace(/^\//, "")}`;
const worksData = await getWorksData();
const works = worksData.activities;
const worksSummaryItems = works.flatMap((work) => (
  work.title === "アニメ・映画など歌入り劇伴歌唱／企業ソングのレコーディング"
    ? ["アニメ・映画など歌入り劇伴歌唱", "企業ソングのレコーディング"]
    : [work.title]
));
const latestNews = (await getCollection("news", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const slugFromId = (id: string) => id.replace(/\.md$/, "");
const videoIdPattern = /^[0-9A-Za-z_-]{11}$/;
const videoIdFromUrl = (href: string) => {
  try {
    const parsed = new URL(href);
    if (parsed.hostname.includes("youtu.be")) return parsed.pathname.replace("/", "");
    if (parsed.pathname.startsWith("/shorts/")) return parsed.pathname.split("/")[2] || "";
    return parsed.searchParams.get("v") || "";
  } catch {
    return "";
  }
};
const heroLeadLines = hero.lead.split("\n");
const youtubeVideos = youtube.featured.map((video) => {
  const videoId = videoIdPattern.test(video.videoId) ? video.videoId : videoIdFromUrl(video.url);
  const embedUrl = videoIdPattern.test(videoId) ? `https://www.youtube-nocookie.com/embed/${videoId}` : "";
  return { ...video, videoId, embedUrl };
});
const latestYoutubeVideo = (() => {
  const video = youtube.latest;
  const videoId = videoIdPattern.test(video.videoId) ? video.videoId : videoIdFromUrl(video.url);
  const embedUrl = videoIdPattern.test(videoId) ? `https://www.youtube-nocookie.com/embed/${videoId}` : "";
  return { ...video, videoId, embedUrl };
})();
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="section-kicker">{hero.label}</p>
        <h1 class="hero-title">{hero.title}</h1>
        <p class="hero-lead">
          {heroLeadLines.map((line) => <span>{line}</span>)}
        </p>
        <div class="button-row">
          <a class="button primary" href={url(hero.primaryCta.href)}>{hero.primaryCta.label}</a>
          <a class="button secondary" href={url(hero.secondaryCta.href)}>{hero.secondaryCta.label}</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <img src={asset(hero.image)} alt={hero.imageAlt} onerror="this.style.display='none'" />
      </figure>
    </div>
  </section>

  <section class="section about-section">
    <div class="section-inner split">
      <div>
        <p class="section-kicker">About</p>
        <h2 class="section-title about-title">
          <span><b>旭</b><small>（あさひ）と</small> <span class="text-keep"><b>ゆみ</b><small>で</small></span></span>
          <span><small>「</small><b>あさゆみ</b><small>」です。</small></span>
        </h2>
      </div>
      <div class="prose">
        <p>
          あさゆみは、東京藝術大学で学んだ声楽家夫婦によるソプラノとバリトンのデュオです。
          クラシックからポップスまで、幅広い歌を届けています。
          演奏会をはじめ、式典やパーティー、学校、各種施設での公演など、全国どこへでも歌いに<span class="text-keep">参ります。</span>
        </p>
        <div class="button-row">
          <a class="button secondary" href={url("/profile/")}>Profile</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-inner">
      <p class="section-kicker">News</p>
      <h2 class="section-title">お知らせ</h2>
      <div class="news-list compact-news" data-home-news data-base-path={basePath}>
        {latestNews.map((post) => (
          <a class:list={["news-card", !post.data.image && "news-card--without-image"]} href={url(`/news/${slugFromId(post.id)}/`)}>
            <div>
              <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
            </div>
            {post.data.image && (
              <img src={asset(post.data.image)} alt={post.data.imageAlt || post.data.title} loading="lazy" onerror="this.remove(); this.parentElement?.classList.add('news-card--without-image')" />
            )}
          </a>
        ))}
      </div>
      <div class="button-row centered">
        <a class="button secondary" href={url("/news/")}>お知らせを見る</a>
      </div>
    </div>
  </section>

  <section class="section" data-youtube-section data-channel-url={youtube.channelUrl}>
    <div class="section-inner">
      <p class="section-kicker">YouTube</p>
      <h2 class="section-title section-title-medium">{youtube.title}</h2>
      <div class="youtube-latest" data-youtube-latest>
        <p class="latest-video-label">最新動画</p>
        <article class="youtube-card youtube-card-large">
          {latestYoutubeVideo.embedUrl && (
            <iframe
              class="youtube-embed"
              src={latestYoutubeVideo.embedUrl}
              title={latestYoutubeVideo.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          )}
            <div class="youtube-card-body">
            {latestYoutubeVideo.subtitle && <p>{latestYoutubeVideo.subtitle}</p>}
            <h3>{latestYoutubeVideo.title}</h3>
            <a href={latestYoutubeVideo.url} target="_blank" rel="noopener noreferrer">YouTubeで見る</a>
          </div>
        </article>
      </div>
      <div class="youtube-grid" data-youtube-featured>
        {youtubeVideos.map((video) => (
          <article class="youtube-card">
            {video.embedUrl && (
              <iframe
                class="youtube-embed"
                src={video.embedUrl}
                title={video.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            )}
            <div class="youtube-card-body">
              <p>{video.subtitle}</p>
              <h3>{video.title}</h3>
              <a href={video.url} target="_blank" rel="noopener noreferrer">YouTubeで見る</a>
            </div>
          </article>
        ))}
      </div>
      <div class="button-row centered">
        <a class="button secondary" href={youtube.channelUrl} target="_blank" rel="noopener noreferrer">YouTubeを見る</a>
      </div>
    </div>
  </section>

  <script>
    import {
      fetchCmsNews,
      fetchCmsYoutube,
      getYoutubeEmbedUrl,
      getYoutubeWatchUrl,
      type CmsNews,
      type CmsVideo,
    } from "../lib/siteCmsClient";

    const youtubeSection = document.querySelector<HTMLElement>("[data-youtube-section]");
    const featuredRoot = document.querySelector<HTMLElement>("[data-youtube-featured]");
    const latestRoot = document.querySelector<HTMLElement>("[data-youtube-latest]");

    const emptyMessage = (message: string) => {
      const element = document.createElement("p");
      element.className = "cms-empty-message";
      element.textContent = message;
      return element;
    };

    const videoCard = (video: CmsVideo, large = false) => {
      const article = document.createElement("article");
      article.className = `youtube-card${large ? " youtube-card-large" : ""}`;
      const embedUrl = getYoutubeEmbedUrl(video);
      if (embedUrl) {
        const iframe = document.createElement("iframe");
        iframe.className = "youtube-embed";
        iframe.src = embedUrl;
        iframe.title = video.title;
        iframe.loading = "lazy";
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        article.append(iframe);
      }

      const body = document.createElement("div");
      body.className = "youtube-card-body";
      if (video.subtitle) {
        const subtitle = document.createElement("p");
        subtitle.textContent = video.subtitle;
        body.append(subtitle);
      }
      const heading = document.createElement("h3");
      heading.textContent = video.title;
      body.append(heading);
      const watchUrl = getYoutubeWatchUrl(video) || youtubeSection?.dataset.channelUrl;
      if (watchUrl) {
        const link = document.createElement("a");
        link.href = watchUrl;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = "YouTubeで見る";
        body.append(link);
      }
      article.append(body);
      return article;
    };

    const loadYoutubeFromCms = async () => {
      if (!featuredRoot || !latestRoot) return;
      const result = await fetchCmsYoutube();
      if (!result.ok) return;

      featuredRoot.replaceChildren(
        ...(result.data.featured.length
          ? result.data.featured.map((video) => videoCard(video))
          : [emptyMessage("現在公開中の動画はありません。")]),
      );
      const latestLabel = document.createElement("p");
      latestLabel.className = "latest-video-label";
      latestLabel.textContent = "最新動画";
      latestRoot.replaceChildren(
        latestLabel,
        result.data.latest ? videoCard(result.data.latest, true) : emptyMessage("現在、最新動画はありません。"),
      );
    };

    const homeNewsRoot = document.querySelector<HTMLElement>("[data-home-news]");

    const newsDetailUrl = (item: CmsNews, basePath: string) => {
      const identifier = item.id || item.slug;
      return identifier ? `${basePath}news/detail/?id=${encodeURIComponent(identifier)}` : undefined;
    };

    const newsCard = (item: CmsNews, basePath: string, headingLevel: "h2" | "h3") => {
      const href = newsDetailUrl(item, basePath);
      const card = document.createElement(href ? "a" : "article");
      card.className = "news-card";
      if (!item.imageUrl) card.classList.add("news-card--without-image");
      if (href && card instanceof HTMLAnchorElement) card.href = href;
      const copy = document.createElement("div");
      const itemDate = document.createElement("time");
      itemDate.dateTime = item.date;
      itemDate.textContent = item.date;
      const heading = document.createElement(headingLevel);
      heading.textContent = item.title;
      copy.append(itemDate, heading);
      if (item.summary) {
        const summary = document.createElement("p");
        summary.textContent = item.summary;
        copy.append(summary);
      }
      card.append(copy);
      if (item.imageUrl) {
        const image = document.createElement("img");
        image.src = item.imageUrl;
        image.alt = item.imageAlt || item.title;
        image.loading = "lazy";
        image.addEventListener("error", () => {
          image.remove();
          card.classList.add("news-card--without-image");
        });
        card.append(image);
      }
      return card;
    };

    const loadHomeNewsFromCms = async () => {
      if (!homeNewsRoot) return;
      const result = await fetchCmsNews();
      if (!result.ok) return;
      const basePath = homeNewsRoot.dataset.basePath || "/";
      const items = [...result.data]
        .sort((a, b) => b.date.localeCompare(a.date))
        .slice(0, 2);
      homeNewsRoot.replaceChildren(
        ...(items.length
          ? items.map((item) => newsCard(item, basePath, "h3"))
          : [emptyMessage("現在お知らせはありません。")]),
      );
    };

    void Promise.all([loadYoutubeFromCms(), loadHomeNewsFromCms()]);
  </script>

  <section class="section band">
    <div class="section-inner">
      <p class="section-kicker">WORKS</p>
      <p class="section-kicker muted-kicker">活動内容</p>
      <h2 class="section-title works-title">
        <span>さまざまな場へ、</span>
        <span>歌を届けています</span>
      </h2>
      <div class="works-gallery" aria-label="あさゆみの活動写真">
        {works.slice(0, 3).map((work) => (
          <figure class="works-photo">
            <img src={asset(work.image)} alt={work.imageAlt} loading="lazy" onerror="this.style.display='none'" />
            <figcaption>{work.title}</figcaption>
          </figure>
        ))}
      </div>
      <div class="works-summary">
        <ul>
          {worksSummaryItems.map((title) => <li>{title}</li>)}
        </ul>
        <p>
          上記に該当しないお仕事でも<wbr />お気軽にご相談ください
        </p>
      </div>
      <div class="button-row centered">
        <a class="button secondary" href={url("/works/")}>活動を見る</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Contact</p>
      <h2 class="section-title">お問い合わせ</h2>
      <p class="section-lead">フォームに必要事項をご入力いただきお問い合わせください</p>
      <div class="button-row">
        <a class="button primary" href={url("/contact/")}>問い合わせる</a>
      </div>
    </div>
  </section>
</BaseLayout>
