---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import hero from "../data/homeHero.json";
import youtube from "../data/youtube.json";
import { getWorksData } from "../lib/contentSources";
import { getCmsEndpoint } from "../lib/siteCms";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (href: string) => `${basePath}${href.replace(/^\//, "")}`;
const asset = (href: string) => href.startsWith("http") ? href : `${basePath}${href.replace(/^\//, "")}`;
const worksData = await getWorksData();
const works = worksData.activities;
const worksSummaryItems = works.flatMap((work) => (
  work.title === "アニメ・映画など歌入り劇伴歌唱／企業ソングのレコーディング"
    ? ["アニメ・映画など歌入り劇伴歌唱", "企業ソングのレコーディング"]
    : [work.title]
));
const latestNews = (await getCollection("news", ({ data }) => data.published))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const slugFromId = (id: string) => id.replace(/\.md$/, "");
const videoIdPattern = /^[0-9A-Za-z_-]{11}$/;
const videoIdFromUrl = (href: string) => {
  try {
    const parsed = new URL(href);
    if (parsed.hostname.includes("youtu.be")) return parsed.pathname.replace("/", "");
    if (parsed.pathname.startsWith("/shorts/")) return parsed.pathname.split("/")[2] || "";
    return parsed.searchParams.get("v") || "";
  } catch {
    return "";
  }
};
const cmsEndpoint = getCmsEndpoint();
const youtubeVideos = youtube.featured.map((video) => {
  const videoId = videoIdPattern.test(video.videoId) ? video.videoId : videoIdFromUrl(video.url);
  const embedUrl = videoIdPattern.test(videoId) ? `https://www.youtube-nocookie.com/embed/${videoId}` : "";
  return { ...video, videoId, embedUrl };
});
const latestYoutubeVideo = (() => {
  const video = youtube.latest;
  const videoId = videoIdPattern.test(video.videoId) ? video.videoId : videoIdFromUrl(video.url);
  const embedUrl = videoIdPattern.test(videoId) ? `https://www.youtube-nocookie.com/embed/${videoId}` : "";
  return { ...video, videoId, embedUrl };
})();
---

<BaseLayout>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="section-kicker">{hero.label}</p>
        <h1 class="hero-title">{hero.title}</h1>
        <p class="hero-lead">{hero.lead}</p>
        <div class="button-row">
          <a class="button primary" href={url(hero.primaryCta.href)}>{hero.primaryCta.label}</a>
          <a class="button secondary" href={url(hero.secondaryCta.href)}>{hero.secondaryCta.label}</a>
        </div>
      </div>
      <figure class="hero-portrait">
        <img src={asset(hero.image)} alt={hero.imageAlt} onerror="this.style.display='none'" />
      </figure>
    </div>
  </section>

  <section class="section about-section">
    <div class="section-inner split">
      <div>
        <p class="section-kicker">About</p>
        <h2 class="section-title about-title">
          <span><b>旭</b><small>（あさひ）と</small> <b>ゆみ</b><small>で</small></span>
          <span><small>「</small><b>あさゆみ</b><small>」です。</small></span>
        </h2>
      </div>
      <div class="prose">
        <p>
          あさゆみは、東京藝術大学で学んだ声楽家夫婦によるソプラノとバリトンのデュオです。
          クラシックからポップスまで、幅広い歌を届けています。
          演奏会をはじめ、式典やパーティー、学校、各種施設での公演など、全国どこへでも歌いに参ります。
        </p>
        <div class="button-row">
          <a class="button secondary" href={url("/profile/")}>Profile</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="section-inner">
      <p class="section-kicker">News</p>
      <h2 class="section-title">お知らせ</h2>
      <div class="news-list compact-news">
        {latestNews.map((post) => (
          <a class="news-card" href={url(`/news/${slugFromId(post.id)}/`)}>
            <div>
              <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
            </div>
            {post.data.image && (
              <img src={asset(post.data.image)} alt={post.data.imageAlt || post.data.title} loading="lazy" onerror="this.style.display='none'" />
            )}
          </a>
        ))}
      </div>
      <div class="button-row centered">
        <a class="button secondary" href={url("/news/")}>お知らせを見る</a>
      </div>
    </div>
  </section>

  <section class="section" data-youtube-section data-cms-endpoint={cmsEndpoint} data-channel-url={youtube.channelUrl}>
    <div class="section-inner">
      <p class="section-kicker">YouTube</p>
      <h2 class="section-title section-title-medium">{youtube.title}</h2>
      <div class="youtube-grid" data-youtube-featured>
        {youtubeVideos.map((video) => (
          <article class="youtube-card">
            {video.embedUrl && (
              <iframe
                class="youtube-embed"
                src={video.embedUrl}
                title={video.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            )}
            <div class="youtube-card-body">
              <p>{video.subtitle}</p>
              <h3>{video.title}</h3>
              <a href={video.url} target="_blank" rel="noopener noreferrer">YouTubeで見る</a>
            </div>
          </article>
        ))}
      </div>
      <div class="youtube-latest" data-youtube-latest>
        <p class="section-kicker muted-kicker">最新動画</p>
        <article class="youtube-card youtube-card-large">
          {latestYoutubeVideo.embedUrl && (
            <iframe
              class="youtube-embed"
              src={latestYoutubeVideo.embedUrl}
              title={latestYoutubeVideo.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          )}
          <div class="youtube-card-body">
            {latestYoutubeVideo.subtitle && <p>{latestYoutubeVideo.subtitle}</p>}
            <h3>{latestYoutubeVideo.title}</h3>
            {latestYoutubeVideo.publishedAt && <time datetime={latestYoutubeVideo.publishedAt}>{latestYoutubeVideo.publishedAt}</time>}
            <a href={latestYoutubeVideo.url} target="_blank" rel="noopener noreferrer">YouTubeで見る</a>
          </div>
        </article>
      </div>
      <div class="button-row centered">
        <a class="button secondary" href={youtube.channelUrl} target="_blank" rel="noopener noreferrer">YouTubeを見る</a>
      </div>
    </div>
  </section>

  <script>
    type CmsVideo = {
      title?: string;
      subtitle?: string;
      url?: string;
      videoId?: string;
      publishedAt?: string;
    };

    type CmsYoutube = {
      featured?: CmsVideo[];
      latest?: CmsVideo;
      channelUrl?: string;
    };

    const youtubeSection = document.querySelector<HTMLElement>("[data-youtube-section]");
    const featuredRoot = document.querySelector<HTMLElement>("[data-youtube-featured]");
    const latestRoot = document.querySelector<HTMLElement>("[data-youtube-latest]");
    const idPattern = /^[0-9A-Za-z_-]{11}$/;

    const escapeHtml = (value = "") => value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");

    const getVideoId = (video: CmsVideo) => {
      if (video.videoId && idPattern.test(video.videoId)) return video.videoId;
      if (!video.url) return "";
      try {
        const parsed = new URL(video.url);
        if (parsed.hostname.includes("youtu.be")) return parsed.pathname.replace("/", "");
        if (parsed.pathname.startsWith("/shorts/")) return parsed.pathname.split("/")[2] || "";
        return parsed.searchParams.get("v") || "";
      } catch {
        return "";
      }
    };

    const cardHtml = (video: CmsVideo, large = false) => {
      const videoId = getVideoId(video);
      const embed = idPattern.test(videoId) ? `https://www.youtube-nocookie.com/embed/${videoId}` : "";
      const url = video.url || (videoId ? `https://www.youtube.com/watch?v=${videoId}` : youtubeSection?.dataset.channelUrl || "#");
      const subtitle = video.subtitle ? `<p>${escapeHtml(video.subtitle)}</p>` : "";
      const publishedAt = video.publishedAt ? `<time datetime="${escapeHtml(video.publishedAt)}">${escapeHtml(video.publishedAt)}</time>` : "";
      const iframe = embed ? `<iframe class="youtube-embed" src="${embed}" title="${escapeHtml(video.title || "YouTube")}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>` : "";
      return `
        <article class="youtube-card${large ? " youtube-card-large" : ""}">
          ${iframe}
          <div class="youtube-card-body">
            ${subtitle}
            <h3>${escapeHtml(video.title || "YouTube")}</h3>
            ${publishedAt}
            <a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">YouTubeで見る</a>
          </div>
        </article>
      `;
    };

    const endpointWithTarget = (endpoint: string, target: string) => `${endpoint}${endpoint.includes("?") ? "&" : "?"}target=${target}`;

    const loadYoutubeFromCms = async () => {
      const endpoint = youtubeSection?.dataset.cmsEndpoint;
      if (!endpoint || !featuredRoot || !latestRoot) return;
      try {
        const response = await fetch(endpointWithTarget(endpoint, "youtube"));
        if (!response.ok) return;
        const data = await response.json() as CmsYoutube;
        const featured = Array.isArray(data.featured) ? data.featured : [];
        if (featured.length) featuredRoot.innerHTML = featured.slice(0, 3).map((video) => cardHtml(video)).join("");
        if (data.latest) {
          latestRoot.innerHTML = `
            <p class="section-kicker muted-kicker">最新動画</p>
            ${cardHtml(data.latest, true)}
          `;
        }
      } catch (error) {
        console.warn("YouTube CMS fetch failed", error);
      }
    };

    loadYoutubeFromCms();
  </script>

  <section class="section band">
    <div class="section-inner">
      <p class="section-kicker">WORKS</p>
      <p class="section-kicker muted-kicker">活動内容</p>
      <h2 class="section-title works-title">
        <span>さまざまな場へ、</span>
        <span>歌を届けています</span>
      </h2>
      <div class="works-gallery" aria-label="あさゆみの活動写真">
        {works.slice(0, 3).map((work) => (
          <figure class="works-photo">
            <img src={asset(work.image)} alt={work.imageAlt} loading="lazy" onerror="this.style.display='none'" />
            <figcaption>{work.title}</figcaption>
          </figure>
        ))}
      </div>
      <div class="works-summary">
        <ul>
          {worksSummaryItems.map((title) => <li>{title}</li>)}
        </ul>
        <p>
          上記に該当しないお仕事でもお気軽にご相談ください
        </p>
      </div>
      <div class="button-row centered">
        <a class="button secondary" href={url("/works/")}>活動を見る</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Contact</p>
      <h2 class="section-title">お問い合わせ</h2>
      <p class="section-lead">ご希望の内容、時期、会場、対象者、予算感などを添えてお問い合わせください。</p>
      <div class="button-row">
        <a class="button primary" href={url("/contact/")}>問い合わせる</a>
      </div>
    </div>
  </section>
</BaseLayout>
