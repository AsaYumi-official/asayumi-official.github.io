---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getWorksData } from "../lib/contentSources";

const asset = (href: string) => href.startsWith("http") ? href : `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${href.replace(/^\//, "")}`;
const categories = ["すべて", "コンサート", "学校・公共施設", "イベント・式典", "メディア出演", "レコーディング"];
const worksData = await getWorksData();
const achievements = [...worksData.achievements]
  .filter((work) => categories.includes(work.category))
  .sort((a, b) => b.date.localeCompare(a.date));
const worksFallback = achievements.map((work) => ({
  ...work,
  imageUrl: work.image ? asset(work.image) : undefined,
}));
---

<BaseLayout title="Works | あさゆみ" description="あさゆみの終了済み出演予定、演奏実績、活動実績の一覧。">
  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Works</p>
      <h1 class="section-title">活動実績</h1>
      <p class="section-lead works-lead"><span class="text-keep">「あさゆみ」として</span><span class="text-keep">出演させていただいた</span><span class="text-keep">これまでの活動を</span><span class="text-keep">まとめています。</span><span class="text-keep">（ソロ活動は掲載しておりません）</span></p>

      <div class="filter-bar" aria-label="実績カテゴリ">
        {categories.map((category, index) => (
          <button class:list={["filter-button", index === 0 && "is-active"]} type="button" data-filter={category} aria-pressed={index === 0 ? "true" : "false"}>{category}</button>
        ))}
      </div>

      <div class="works-results" data-works-results data-fallback={JSON.stringify(worksFallback)} data-cms-state="loading" aria-busy="true">
        <div class="cms-skeleton-card cms-work-skeleton-card cms-js-only" aria-hidden="true"><span class="cms-skeleton-media"></span><span class="cms-skeleton-line cms-skeleton-line-short"></span><span class="cms-skeleton-line cms-skeleton-line-title"></span><span class="cms-skeleton-line"></span></div>
        <div class="cms-skeleton-card cms-work-skeleton-card cms-js-only" aria-hidden="true"><span class="cms-skeleton-media"></span><span class="cms-skeleton-line cms-skeleton-line-short"></span><span class="cms-skeleton-line cms-skeleton-line-title"></span><span class="cms-skeleton-line"></span></div>
        <div class="cms-skeleton-card cms-work-skeleton-card cms-js-only" aria-hidden="true"><span class="cms-skeleton-media"></span><span class="cms-skeleton-line cms-skeleton-line-short"></span><span class="cms-skeleton-line cms-skeleton-line-title"></span><span class="cms-skeleton-line"></span></div>
        <noscript>
          <style>.cms-js-only { display: none !important; }</style>
          {achievements.map((work) => (
            <article class:list={["work-result-card", !work.image && "work-result-card--without-image"]} data-category={work.category}>
              {work.image && (
                <img src={asset(work.image)} alt={`${work.title}の写真`} loading="lazy" onerror="this.remove(); this.parentElement?.classList.add('work-result-card--without-image')" />
              )}
              <div>
                <div class="work-meta">
                  <time datetime={work.date}>{work.date}</time>
                  <span>{work.category}</span>
                </div>
                <h2>{work.title}</h2>
                <p class="work-location">{work.location}</p>
                <p>{work.description}</p>
              </div>
            </article>
          ))}
        </noscript>
      </div>
    </div>
  </section>

  <script>
    import { fetchCmsWorks, getCmsWorksCache, prefetchCmsTargets, type CmsWork } from "../lib/siteCmsClient";

    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-button");
    const results = document.querySelector<HTMLElement>("[data-works-results]");
    let activeFilter = "すべて";

    const parseFallback = <T,>(value: string | undefined): T | null => {
      if (!value) return null;
      try {
        return JSON.parse(value) as T;
      } catch {
        return null;
      }
    };

    const applyFilter = (filter: string) => {
      if (!results) return;
      results.querySelectorAll<HTMLElement>(".work-result-card").forEach((card) => {
        const matches = filter === "すべて" || card.dataset.category === filter;
        card.hidden = !matches;
        card.classList.toggle("is-hidden", !matches);
      });
    };

    const emptyMessage = () => {
      const element = document.createElement("p");
      element.className = "cms-empty-message";
      element.textContent = "現在活動実績はありません。";
      return element;
    };

    const workCard = (work: CmsWork) => {
      const card = document.createElement("article");
      card.className = "work-result-card";
      card.dataset.category = work.category;
      if (work.imageUrl) {
        const image = document.createElement("img");
        image.src = work.imageUrl;
        image.alt = `${work.title}の写真`;
        image.loading = "lazy";
        image.addEventListener("error", () => {
          image.remove();
          card.classList.add("work-result-card--without-image");
        });
        card.append(image);
      } else {
        card.classList.add("work-result-card--without-image");
      }
      const copy = document.createElement("div");
      const meta = document.createElement("div");
      meta.className = "work-meta";
      const itemDate = document.createElement("time");
      itemDate.dateTime = work.date;
      itemDate.textContent = work.date;
      const category = document.createElement("span");
      category.textContent = work.category;
      meta.append(itemDate, category);
      const heading = document.createElement("h2");
      heading.textContent = work.title;
      copy.append(meta, heading);
      if (work.location) {
        const location = document.createElement("p");
        location.className = "work-location";
        location.textContent = work.location;
        copy.append(location);
      }
      if (work.description) {
        const description = document.createElement("p");
        description.textContent = work.description;
        copy.append(description);
      }
      card.append(copy);
      return card;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter || "すべて";
        activeFilter = filter;
        buttons.forEach((item) => {
          const active = item === button;
          item.setAttribute("aria-pressed", String(active));
          item.classList.toggle("is-active", active);
        });
        applyFilter(filter);
      });
    });

    let worksSignature = "";
    const renderWorks = (items: CmsWork[], state: "ready" | "fallback") => {
      if (!results) return;
      const signature = JSON.stringify(items);
      if (signature === worksSignature) return;
      worksSignature = signature;
      results.replaceChildren(
        ...(items.length ? items.map(workCard) : [emptyMessage()]),
      );
      applyFilter(activeFilter);
      results.setAttribute("aria-busy", "false");
      results.setAttribute("data-cms-state", state);
    };

    const worksFallback = parseFallback<CmsWork[]>(results?.dataset.fallback);
    const cachedWorks = getCmsWorksCache();
    if (cachedWorks) renderWorks(cachedWorks.data, "ready");

    const loadWorksFromCms = async () => {
      const result = await fetchCmsWorks();
      if (result.ok) {
        renderWorks(result.data, "ready");
        return;
      }
      if (!cachedWorks && worksFallback) renderWorks(worksFallback, "fallback");
    };

    void loadWorksFromCms().finally(() => prefetchCmsTargets(["youtube", "news", "schedule"]));
  </script>
</BaseLayout>
