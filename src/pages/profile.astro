---
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (href: string) => `${basePath}${href.replace(/^\//, "")}`;
const asset = (href: string) => href.startsWith("http") ? href : `${basePath}${href.replace(/^\//, "")}`;
---

<BaseLayout title="Profile | あさゆみ" description="片倉旭、朝光ゆみによる声楽家夫婦デュオ「あさゆみ」のプロフィール。">
  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Profile</p>
      <h1 class="section-title">プロフィール</h1>
      <p class="section-lead">{profile.intro}</p>
    </div>
  </section>

  <section class="section band profile-section">
    <div class="section-inner">
      <div class="profile-list">
        {profile.members.map((member) => (
          <article class="profile-member">
            <figure>
              <img src={asset(member.image)} alt={member.imageAlt} loading="lazy" onerror="this.style.display='none'" />
            </figure>
            <div>
              <p class="voice-label">{member.voice}</p>
              <h2>{member.name}</h2>
              <p class="name-reading">
                <span>{member.kana}</span>
                <span>{member.roman}</span>
              </p>
              <div class="prose">
                {member.body.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="profile-gallery">
        {profile.gallery.map((item, index) => (
          <figure class:list={["profile-gallery-card", index === 0 ? "profile-gallery-left" : "profile-gallery-right"]}>
            <img src={asset(item.image)} alt={item.imageAlt} loading="lazy" onerror="this.style.display='none'" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner narrow centered-copy">
      <p>「あさゆみ」としての活動実績は Worksページをご覧ください。各種お問い合わせはこちらからお送りください。</p>
      <div class="button-row centered">
        <a class="button secondary" href={url("/works/")}>Worksページ</a>
        <a class="button primary" href={url("/contact/")}>Contactページ</a>
      </div>
    </div>
  </section>
</BaseLayout>
