---
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../data/profile.json";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const url = (href: string) => `${basePath}${href.replace(/^\//, "")}`;
const asset = (href: string) => href.startsWith("http") ? href : `${basePath}${href.replace(/^\//, "")}`;
const noBreakWords = ["メンデルスゾーン", "バリトンソロ", "ミュージカル", "レコーディング"];
const noBreakPattern = new RegExp(`(${noBreakWords.join("|")})`, "g");
const profileTextParts = (text: string) =>
  text.split(noBreakPattern).map((part) => ({
    text: part,
    keep: noBreakWords.includes(part),
  }));
const mobileLineMap: Record<string, string[]> = {
  "片倉 旭|シューベルトを中心とするドイツリートの研究と演奏活動に取り組むほか、ベートーヴェン《交響曲第九番》、メンデルスゾーン《エリヤ》、マーラー《さすらう若人の歌》などバリトンソロを務める。": [
    "シューベルトを中心とするドイツリートの研究と",
    "演奏活動に取り組むほか、",
    "ベートーヴェン《交響曲第九番》、メンデルスゾーン《エリヤ》、",
    "マーラー《さすらう若人の歌》など",
    "バリトンソロを務める。",
  ],
  "片倉 旭|オペラでは木下牧子《陰陽師》、フィリップ・グラス《恐るべき子供たち》など、現代作品に積極的に出演している。趣味はゲーム。": [
    "オペラでは木下牧子《陰陽師》、",
    "フィリップ・グラス《恐るべき子供たち》など、",
    "現代作品に積極的に出演している。趣味はゲーム。",
  ],
  "朝光 ゆみ|クラシックだけでなくポップスやミュージカル、映画音楽などもレパートリーに持ち、アニメ・ゲームの歌入り劇伴レコーディングやコンサートにも多数参加。": [
    "クラシックだけでなくポップスやミュージカル、映画音楽などもレパートリーに持ち、",
    "アニメ・ゲームの歌入り劇伴レコーディングや",
    "コンサートにも多数参加。",
  ],
};
const normalizeProfileText = (text: string) => text.replace(/\n/g, "");
const mobileLinesFor = (memberName: string, paragraph: string) =>
  mobileLineMap[`${memberName}|${normalizeProfileText(paragraph)}`];
---

<BaseLayout title="Profile | あさゆみ" description="片倉旭、朝光ゆみによる声楽家夫婦デュオ「あさゆみ」のプロフィール。">
  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Profile</p>
      <h1 class="section-title">プロフィール</h1>
      <p class="section-lead">{profile.intro}</p>
    </div>
  </section>

  <section class="section band profile-section">
    <div class="section-inner">
      <div class="profile-list">
        {profile.members.map((member) => (
          <article class="profile-member">
            <figure>
              <img src={asset(member.image)} alt={member.imageAlt} loading="lazy" onerror="this.style.display='none'" />
            </figure>
            <div>
              <p class="voice-label">{member.voice}</p>
              <h2>{member.name}</h2>
              <p class="name-reading">
                <span>{member.kana}</span>
                <span>{member.roman}</span>
              </p>
              <div class="prose">
                {member.body.map((paragraph) => (
                  <p>
                    {mobileLinesFor(member.name, paragraph)?.map((line) => (
                      <span class="profile-mobile-line">
                        {profileTextParts(line).map((part) => (
                          part.keep ? <span class="profile-no-break">{part.text}</span> : part.text
                        ))}
                      </span>
                    )) || profileTextParts(paragraph).map((part) => (
                      part.keep ? <span class="profile-no-break">{part.text}</span> : part.text
                    ))}
                  </p>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="profile-gallery">
        {profile.gallery.map((item, index) => (
          <figure class:list={["profile-gallery-card", index === 0 ? "profile-gallery-left" : "profile-gallery-right"]}>
            <img src={asset(item.image)} alt={item.imageAlt} loading="lazy" onerror="this.style.display='none'" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner narrow centered-copy">
      <p>「あさゆみ」としての活動実績は Worksページをご覧ください。各種お問い合わせはこちらからお送りください。</p>
      <div class="button-row centered">
        <a class="button secondary" href={url("/works/")}>Worksページ</a>
        <a class="button primary" href={url("/contact/")}>Contactページ</a>
      </div>
    </div>
  </section>
</BaseLayout>
