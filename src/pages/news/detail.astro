---
import BaseLayout from "../../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title="お知らせ | あさゆみ" description="あさゆみのお知らせ詳細。">
  <article class="section news-detail" data-news-detail data-base-path={basePath}>
    <div class="section-inner narrow" data-news-detail-content>
      <p class="section-kicker">News</p>
      <p class="cms-empty-message">記事を読み込んでいます。</p>
    </div>
  </article>

  <script>
    import { fetchCmsNews, type CmsNews } from "../../lib/siteCmsClient";

    const detailRoot = document.querySelector<HTMLElement>("[data-news-detail]");
    const contentRoot = document.querySelector<HTMLElement>("[data-news-detail-content]");

    const addBackLink = (root: HTMLElement, basePath: string) => {
      const actions = document.createElement("div");
      actions.className = "button-row";
      const link = document.createElement("a");
      link.className = "button secondary";
      link.href = `${basePath}news/`;
      link.textContent = "お知らせ一覧へ戻る";
      actions.append(link);
      root.append(actions);
    };

    const showMissing = (message: string, basePath: string) => {
      if (!contentRoot) return;
      contentRoot.replaceChildren();
      const kicker = document.createElement("p");
      kicker.className = "section-kicker";
      kicker.textContent = "News";
      const heading = document.createElement("h1");
      heading.className = "section-title section-title-medium";
      heading.textContent = message;
      contentRoot.append(kicker, heading);
      addBackLink(contentRoot, basePath);
    };

    const appendBody = (root: HTMLElement, body: string | undefined, summary: string | undefined) => {
      const articleBody = document.createElement("div");
      articleBody.className = "article-body";
      const paragraphs = (body || summary || "")
        .split(/\r?\n+/)
        .map((paragraph) => paragraph.trim())
        .filter(Boolean);
      paragraphs.forEach((paragraph) => {
        const element = document.createElement("p");
        element.textContent = paragraph;
        articleBody.append(element);
      });
      if (paragraphs.length) root.append(articleBody);
    };

    const renderArticle = (item: CmsNews, basePath: string) => {
      if (!contentRoot) return;
      contentRoot.replaceChildren();
      const kicker = document.createElement("p");
      kicker.className = "section-kicker";
      kicker.textContent = "News";
      const itemDate = document.createElement("time");
      itemDate.dateTime = item.date;
      itemDate.textContent = item.date;
      const heading = document.createElement("h1");
      heading.className = "section-title section-title-medium";
      heading.textContent = item.title;
      contentRoot.append(kicker, itemDate, heading);
      if (item.summary) {
        const summary = document.createElement("p");
        summary.className = "section-lead";
        summary.textContent = item.summary;
        contentRoot.append(summary);
      }
      if (item.imageUrl) {
        const image = document.createElement("img");
        image.className = "news-detail-image";
        image.src = item.imageUrl;
        image.alt = item.imageAlt || item.title;
        image.loading = "lazy";
        image.addEventListener("error", () => image.remove());
        contentRoot.append(image);
      }
      appendBody(contentRoot, item.body, item.summary);
      addBackLink(contentRoot, basePath);
      document.title = `${item.title} | あさゆみ`;
    };

    const loadArticle = async () => {
      const basePath = detailRoot?.dataset.basePath || "/";
      const identifier = new URLSearchParams(window.location.search).get("id");
      if (!identifier) {
        showMissing("記事が見つかりません", basePath);
        return;
      }
      const result = await fetchCmsNews();
      if (!result.ok) {
        showMissing("記事が見つかりません", basePath);
        return;
      }
      const article = result.data.find((item) => item.id === identifier || item.slug === identifier);
      if (!article) {
        showMissing("記事が見つかりません", basePath);
        return;
      }
      renderArticle(article, basePath);
    };

    loadArticle();
  </script>
</BaseLayout>
