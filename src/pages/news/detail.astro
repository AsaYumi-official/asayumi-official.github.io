---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const asset = (href: string) => href.startsWith("http") ? href : `${basePath}${href.replace(/^\//, "")}`;
const fallbackNews = (await getCollection("news", ({ data }) => data.published)).map((post) => {
  const slug = post.id.replace(/\.md$/, "");
  return {
    id: slug,
    slug,
    date: post.data.date.toISOString().slice(0, 10),
    title: post.data.title,
    summary: post.data.summary,
    body: post.body,
    imageUrl: post.data.image ? asset(post.data.image) : undefined,
    imageAlt: post.data.imageAlt || undefined,
  };
});
---

<BaseLayout title="お知らせ | あさゆみ" description="あさゆみのお知らせ詳細。">
  <article class="section news-detail" data-news-detail data-base-path={basePath} data-fallback={JSON.stringify(fallbackNews)} data-cms-state="loading" aria-busy="true">
    <div class="section-inner narrow" data-news-detail-content>
      <p class="section-kicker">News</p>
      <div class="cms-detail-skeleton cms-js-only" aria-hidden="true">
        <span class="cms-skeleton-line cms-skeleton-line-short"></span>
        <span class="cms-skeleton-line cms-skeleton-line-heading"></span>
        <span class="cms-skeleton-line"></span>
        <span class="cms-skeleton-line"></span>
        <span class="cms-skeleton-media"></span>
      </div>
      <noscript>
        <style>.cms-js-only { display: none !important; }</style>
        <p class="cms-empty-message">JavaScriptが無効のため、ローカルのお知らせ一覧を表示しています。</p>
        <div class="article-body">
          {fallbackNews.map((item) => <p><a href={`${basePath}news/${item.slug}/`}>{item.date}　{item.title}</a></p>)}
        </div>
      </noscript>
    </div>
  </article>

  <script>
    import { fetchCmsNews, getCmsNewsCache, prefetchCmsTargets, type CmsNews } from "../../lib/siteCmsClient";

    const detailRoot = document.querySelector<HTMLElement>("[data-news-detail]");
    const contentRoot = document.querySelector<HTMLElement>("[data-news-detail-content]");

    const parseFallback = <T,>(value: string | undefined): T | null => {
      if (!value) return null;
      try {
        return JSON.parse(value) as T;
      } catch {
        return null;
      }
    };

    const addBackLink = (root: HTMLElement, basePath: string) => {
      const actions = document.createElement("div");
      actions.className = "button-row";
      const link = document.createElement("a");
      link.className = "button secondary";
      link.href = `${basePath}news/`;
      link.textContent = "お知らせ一覧へ戻る";
      actions.append(link);
      root.append(actions);
    };

    const showMissing = (message: string, basePath: string) => {
      if (!contentRoot) return;
      contentRoot.replaceChildren();
      const kicker = document.createElement("p");
      kicker.className = "section-kicker";
      kicker.textContent = "News";
      const heading = document.createElement("h1");
      heading.className = "section-title section-title-medium";
      heading.textContent = message;
      contentRoot.append(kicker, heading);
      addBackLink(contentRoot, basePath);
      detailRoot?.setAttribute("aria-busy", "false");
      detailRoot?.setAttribute("data-cms-state", "error");
    };

    const appendLinkedText = (root: HTMLElement, text: string) => {
      const urlPattern = /https?:\/\/[^\s<>]+/g;
      let lastIndex = 0;

      for (const match of text.matchAll(urlPattern)) {
        const matchIndex = match.index ?? 0;
        const rawUrl = match[0];
        const url = rawUrl.replace(/[.,!?;:)}\]）】」』]+$/u, "");
        const trailingText = rawUrl.slice(url.length);

        root.append(document.createTextNode(text.slice(lastIndex, matchIndex)));
        try {
          const link = document.createElement("a");
          link.href = new URL(url).href;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.textContent = url;
          root.append(link);
        } catch {
          root.append(document.createTextNode(url));
        }
        root.append(document.createTextNode(trailingText));
        lastIndex = matchIndex + rawUrl.length;
      }

      root.append(document.createTextNode(text.slice(lastIndex)));
    };

    const appendBody = (root: HTMLElement, body: string | undefined, summary: string | undefined) => {
      const articleBody = document.createElement("div");
      articleBody.className = "article-body";
      const paragraphs = (body || summary || "")
        .split(/\r?\n+/)
        .map((paragraph) => paragraph.trim())
        .filter(Boolean);
      paragraphs.forEach((paragraph) => {
        const element = document.createElement("p");
        appendLinkedText(element, paragraph);
        articleBody.append(element);
      });
      if (paragraphs.length) root.append(articleBody);
    };

    let articleSignature = "";
    const renderArticle = (item: CmsNews, basePath: string, state: "ready" | "fallback") => {
      if (!contentRoot) return;
      const signature = JSON.stringify(item);
      if (signature === articleSignature) return;
      articleSignature = signature;
      contentRoot.replaceChildren();
      const kicker = document.createElement("p");
      kicker.className = "section-kicker";
      kicker.textContent = "News";
      const itemDate = document.createElement("time");
      itemDate.dateTime = item.date;
      itemDate.textContent = item.date;
      const heading = document.createElement("h1");
      heading.className = "section-title section-title-medium";
      heading.textContent = item.title;
      contentRoot.append(kicker, itemDate, heading);
      if (item.summary) {
        const summary = document.createElement("p");
        summary.className = "section-lead";
        summary.textContent = item.summary;
        contentRoot.append(summary);
      }
      if (item.imageUrl) {
        const image = document.createElement("img");
        image.className = "news-detail-image";
        image.src = item.imageUrl;
        image.alt = item.imageAlt || item.title;
        image.loading = "lazy";
        image.addEventListener("error", () => image.remove());
        contentRoot.append(image);
      }
      appendBody(contentRoot, item.body, item.summary);
      addBackLink(contentRoot, basePath);
      document.title = `${item.title} | あさゆみ`;
      detailRoot?.setAttribute("aria-busy", "false");
      detailRoot?.setAttribute("data-cms-state", state);
    };

    const loadArticle = async () => {
      const basePath = detailRoot?.dataset.basePath || "/";
      const identifier = new URLSearchParams(window.location.search).get("id");
      if (!identifier) {
        showMissing("記事が見つかりません", basePath);
        return;
      }
      const fallbackNews = parseFallback<CmsNews[]>(detailRoot?.dataset.fallback) || [];
      const cachedNews = getCmsNewsCache();
      const cachedArticle = cachedNews?.data.find((item) => item.id === identifier || item.slug === identifier);
      if (cachedArticle) renderArticle(cachedArticle, basePath, "ready");
      const result = await fetchCmsNews();
      if (!result.ok) {
        if (!cachedArticle) {
          const fallbackArticle = fallbackNews.find((item) => item.id === identifier || item.slug === identifier);
          if (fallbackArticle) renderArticle(fallbackArticle, basePath, "fallback");
          else showMissing("記事が見つかりません", basePath);
        }
        return;
      }
      const article = result.data.find((item) => item.id === identifier || item.slug === identifier);
      if (!article) {
        showMissing("記事が見つかりません", basePath);
        return;
      }
      renderArticle(article, basePath, "ready");
    };

    void loadArticle().finally(() => prefetchCmsTargets(["youtube", "works", "schedule"]));
  </script>
</BaseLayout>
