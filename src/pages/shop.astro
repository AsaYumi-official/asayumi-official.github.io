---
import BaseLayout from "../layouts/BaseLayout.astro";

const shopUrl = "https://asayumishop.stores.jp/";
---

<BaseLayout title="Shop | あさゆみ" description="あさゆみのショップはSTORESでご覧いただけます。">
  <section class="section">
    <div class="section-inner narrow">
      <p class="section-kicker">Shop</p>
      <h1 class="section-title section-title-medium">Shop</h1>
      <p class="section-lead">音源、楽譜、グッズなどの販売情報はSTORESでご案内します。</p>
      <div class="button-row">
        <a class="button primary" href={shopUrl} target="_blank" rel="noopener noreferrer">STORESへ移動</a>
      </div>
    </div>
  </section>
</BaseLayout>
