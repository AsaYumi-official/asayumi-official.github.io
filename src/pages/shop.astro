---
import BaseLayout from "../layouts/BaseLayout.astro";
import products from "../data/shop.json";

const url = (href: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${href.replace(/^\//, "")}`;
---

<BaseLayout title="Shop | あさゆみ" description="あさゆみの音源、楽譜、グッズなどのショップ情報。">
  <section class="section">
    <div class="section-inner">
      <p class="section-kicker">Shop</p>
      <h1 class="section-title">Shop</h1>
      <p class="section-lead">音源、楽譜、グッズなどの販売情報を今後掲載します。</p>
      <div class="grid" style="margin-top: 34px;">
        {products.map((product) => (
          <a class="shop-item" href={url(product.href)}>
            <strong>{product.name}</strong>
            <span>{product.description}</span>
            <span>{product.price}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
