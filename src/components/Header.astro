---
import snsLinks from "../data/sns.json";
import SocialLink from "./SocialLink.astro";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Profile", href: "/profile/" },
  { label: "Works", href: "/works/" },
  { label: "Schedule", href: "/schedule/" },
  { label: "Contact", href: "/contact/" },
  { label: "Shop↗", href: "https://asayumishop.stores.jp/", external: true },
];

const url = (href: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${href.replace(/^\//, "")}`;
const linkHref = (href: string) => href.startsWith("http") ? href : url(href);
---

<header class="site-header">
  <a class="brand" href={url("/")}>
    <span class="brand-mark-image">
      <picture>
        <source srcset={url("/images/brand-mark-on-white.svg")} type="image/svg+xml" />
        <source srcset={url("/images/brand-mark-on-white.png")} type="image/png" />
        <source srcset={url("/images/brand-mark.svg")} type="image/svg+xml" />
        <img src={url("/images/brand-mark.png")} alt="あさゆみ ロゴ" onerror="this.style.display='none'" />
      </picture>
      <span aria-hidden="true">A</span>
    </span>
    <span class="brand-wordmark">
      <img src={url("/images/logo-wordmark.svg")} alt="あさゆみ ロゴ" onerror="this.style.display='none'" />
      <span>
        <strong>あさゆみ</strong>
        <small>Asayumi Official</small>
      </span>
    </span>
  </a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {navItems.map((item) => (
      <a href={linkHref(item.href)} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
        {item.label}
      </a>
    ))}
    <div class="nav-socials" aria-label="SNS links">
      {snsLinks.map((link) => (
        <SocialLink {...link} />
      ))}
    </div>
  </nav>
  <details class="mobile-nav">
    <summary aria-label="メニューを開く">
      <span></span>
      <span></span>
      <span></span>
    </summary>
    <div class="mobile-nav-panel">
      {navItems.map((item) => (
        <a href={linkHref(item.href)} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined}>
          {item.label}
        </a>
      ))}
      <div class="nav-socials mobile-socials" aria-label="SNS links">
        {snsLinks.map((link) => (
          <SocialLink {...link} />
        ))}
      </div>
    </div>
  </details>
</header>
