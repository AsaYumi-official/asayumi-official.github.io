---
import snsLinks from "../data/sns.json";
import SocialLink from "./SocialLink.astro";

const url = (href: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${href.replace(/^\//, "")}`;
---

<footer class="site-footer">
  <div>
    <a class="footer-brand" href={url("/")}>
      <img src={url("/images/logo-wordmark.svg")} alt="あさゆみ ロゴ" onerror="this.closest('.footer-brand').classList.add('is-fallback'); this.style.display='none'" />
      <span>あさゆみ</span>
    </a>
    <p>東京藝術大学卒の声楽家夫婦デュオ</p>
  </div>
  <div class="footer-links" aria-label="SNS links">
    {snsLinks.map((link) => (
      <SocialLink {...link} />
    ))}
  </div>
  <p class="copyright">© {new Date().getFullYear()} Asayumi. All rights reserved.</p>
</footer>
